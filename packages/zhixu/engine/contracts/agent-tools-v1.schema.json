{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhixu:spec:agent-tools:v1",
  "title": "Zhixu v1 logical MCP tool call input",
  "description": "This validates name + arguments inside tools/call, not the MCP protocol envelope. Defaults require application normalization. Semantic validation and authorization remain mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/zhixu_list_tasks"
    },
    {
      "$ref": "#/$defs/zhixu_today_agenda"
    },
    {
      "$ref": "#/$defs/zhixu_get_record"
    },
    {
      "$ref": "#/$defs/zhixu_create_task"
    },
    {
      "$ref": "#/$defs/zhixu_update_task"
    },
    {
      "$ref": "#/$defs/zhixu_list_events"
    },
    {
      "$ref": "#/$defs/zhixu_create_event"
    },
    {
      "$ref": "#/$defs/zhixu_update_event"
    },
    {
      "$ref": "#/$defs/zhixu_search_notes"
    },
    {
      "$ref": "#/$defs/zhixu_save_note"
    },
    {
      "$ref": "#/$defs/zhixu_update_note"
    },
    {
      "$ref": "#/$defs/zhixu_search_documents"
    }
  ],
  "$defs": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "A valid IANA zone. Application validation is mandatory; default is the system zone."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "optionalTimestamp": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/timestamp"
        }
      ]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "taskStatus": {
      "enum": [
        "pending",
        "in_progress",
        "done",
        "canceled"
      ]
    },
    "repeat": {
      "enum": [
        "none",
        "daily",
        "weekly"
      ],
      "default": "none"
    },
    "priority": {
      "enum": [
        "normal",
        "important"
      ],
      "default": "normal"
    },
    "reminderOffset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 10080,
      "default": null
    },
    "overlapPolicy": {
      "enum": [
        "reject",
        "allow"
      ],
      "default": "reject"
    },
    "zhixu_list_tasksArguments": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskStatus"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "dateFrom": {
          "$ref": "#/$defs/date"
        },
        "dateTo": {
          "$ref": "#/$defs/date"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "limit": {
          "$ref": "#/$defs/limit"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "zhixu_list_tasks": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_list_tasks"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_list_tasksArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_today_agendaArguments": {
      "type": "object",
      "properties": {
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "zhixu_today_agenda": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_today_agenda"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_today_agendaArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_get_recordArguments": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "event",
            "note"
          ]
        },
        "id": {
          "$ref": "#/$defs/recordId"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "zhixu_get_record": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_get_record"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_get_recordArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_create_taskArguments": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "dueAt": {
          "$ref": "#/$defs/optionalTimestamp"
        },
        "remindAt": {
          "$ref": "#/$defs/optionalTimestamp"
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        }
      },
      "required": [
        "title",
        "operationId"
      ],
      "additionalProperties": false
    },
    "zhixu_create_task": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_create_task"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_create_taskArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_update_taskArguments": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "expectedVersion": {
          "$ref": "#/$defs/version"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "dueAt": {
          "$ref": "#/$defs/optionalTimestamp"
        },
        "remindAt": {
          "$ref": "#/$defs/optionalTimestamp"
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "status": {
          "$ref": "#/$defs/taskStatus"
        }
      },
      "required": [
        "id",
        "expectedVersion",
        "operationId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "dueAt"
          ]
        },
        {
          "required": [
            "remindAt"
          ]
        },
        {
          "required": [
            "repeat"
          ]
        },
        {
          "required": [
            "priority"
          ]
        },
        {
          "required": [
            "timeZone"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "status"
          ]
        }
      ]
    },
    "zhixu_update_task": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_update_task"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_update_taskArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_list_eventsArguments": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/timestamp"
        },
        "to": {
          "$ref": "#/$defs/timestamp"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "includeCanceled": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "$ref": "#/$defs/limit"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "zhixu_list_events": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_list_events"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_list_eventsArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_create_eventArguments": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "reminderOffsetMinutes": {
          "$ref": "#/$defs/reminderOffset"
        },
        "overlapPolicy": {
          "$ref": "#/$defs/overlapPolicy"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        }
      },
      "required": [
        "title",
        "start",
        "end",
        "operationId"
      ],
      "additionalProperties": false
    },
    "zhixu_create_event": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_create_event"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_create_eventArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_update_eventArguments": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "expectedVersion": {
          "$ref": "#/$defs/version"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "reminderOffsetMinutes": {
          "$ref": "#/$defs/reminderOffset"
        },
        "overlapPolicy": {
          "$ref": "#/$defs/overlapPolicy"
        },
        "status": {
          "enum": [
            "scheduled",
            "canceled"
          ]
        },
        "expectedReminderVersion": {
          "$ref": "#/$defs/version"
        }
      },
      "required": [
        "id",
        "expectedVersion",
        "operationId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "start"
          ]
        },
        {
          "required": [
            "end"
          ]
        },
        {
          "required": [
            "location"
          ]
        },
        {
          "required": [
            "timeZone"
          ]
        },
        {
          "required": [
            "reminderOffsetMinutes"
          ]
        },
        {
          "required": [
            "status"
          ]
        }
      ]
    },
    "zhixu_update_event": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_update_event"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_update_eventArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_search_notesArguments": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "note",
            "preference",
            "all"
          ],
          "default": "note"
        },
        "limit": {
          "$ref": "#/$defs/limit"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "zhixu_search_notes": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_search_notes"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_search_notesArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_save_noteArguments": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "note",
            "preference"
          ],
          "default": "note"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        }
      },
      "required": [
        "title",
        "body",
        "operationId"
      ],
      "additionalProperties": false
    },
    "zhixu_save_note": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_save_note"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_save_noteArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_update_noteArguments": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "expectedVersion": {
          "$ref": "#/$defs/version"
        },
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "expectedVersion",
        "operationId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "body"
          ]
        }
      ]
    },
    "zhixu_update_note": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_update_note"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_update_noteArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "zhixu_search_documentsArguments": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "zhixu_search_documents": {
      "type": "object",
      "properties": {
        "name": {
          "const": "zhixu_search_documents"
        },
        "arguments": {
          "$ref": "#/$defs/zhixu_search_documentsArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  }
}
