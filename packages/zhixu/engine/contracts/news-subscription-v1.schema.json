{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhixu:spec:news-subscription:v1",
  "title": "Zhixu daily news subscription v1 configuration",
  "description": "Configuration only; runtime id/version/timestamps live outside this object. The application must apply defaults, validate IANA time zones, selected tools, models and channel bindings.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S",
      "default": "每日新闻"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "keywords": {
      "description": "Optional extra search terms (companies, industries, products). Each keyword is searched like a topic; hits join the same material.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\S"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "default": []
    },
    "excludeTopics": {
      "description": "Topics to exclude. Candidates whose title/summary matches an excluded term are dropped before the model sees them (a real filter step, not just prompt text).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\S"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "default": []
    },
    "summaryStyle": {
      "description": "Supported summary style; applied when the model writes each item summary. concise≈60, standard≈150, detailed≈300 characters.",
      "enum": [
        "concise",
        "standard",
        "detailed"
      ],
      "default": "standard"
    },
    "searchServerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "\\S"
    },
    "searchToolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "sendTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
      "default": "09:00"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "A valid IANA zone. Application validation is mandatory; default is the system zone."
    },
    "windowHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168,
      "default": 24
    },
    "newsCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "desktop",
          "feishu",
          "weixin"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "default": [
        "desktop"
      ]
    },
    "notifyPet": {
      "type": "boolean",
      "default": true
    },
    "respectQuietHours": {
      "type": "boolean",
      "default": true
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "catchupGraceMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440,
      "default": 180
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxSearchCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 180
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {
        "maxSearchCalls": 5,
        "maxModelCalls": 2,
        "timeoutSeconds": 180
      }
    }
  },
  "required": [
    "topics",
    "searchServerId",
    "searchToolName",
    "timeZone"
  ],
  "additionalProperties": false
}
