{
  "name": "@xtcausal/dot-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DOT 组合层：在 DSH base+web 之上做 DOT 自己的行覆盖（ASTRA 身份、root 归属、DOT 插件行）",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "LICENSE",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT"
}
