{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xtcausal:dot:plugin:1",
  "title": "XTCausal Dot Plugin Manifest v1",
  "description": "Dot产品清单，不是DSH原生插件格式。结构通过后仍须宿主做权限与生命周期校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "id", "version", "displayName", "kind", "runtime", "compatibility", "entry", "permissions", "tools", "instructions", "data", "lifecycle", "dependencies"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$", "maxLength": 96},
    "version": {"$ref": "#/$defs/version"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 100},
    "kind": {"enum": ["connector", "industry", "capability"]},
    "runtime": {"enum": ["trusted-host", "external-worker"]},
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["dotApi", "testedDsh"],
      "properties": {
        "dotApi": {"const": "1"},
        "testedDsh": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/version"}}
      }
    },
    "entry": {"$ref": "#/$defs/relativePath"},
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(workspace:(read|write)|memory:(recall|store)|schedule:own|notifications:send|artifacts:write|network:[a-z][a-z0-9-]*|connector:[a-z][a-z0-9-]*:(read|write))$"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "inputSchema", "outputSchema", "effect", "approval", "recovery", "timeoutSeconds"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "inputSchema": {"$ref": "#/$defs/relativePath"},
          "outputSchema": {"$ref": "#/$defs/relativePath"},
          "effect": {"enum": ["read", "workspace-write", "external-write"]},
          "approval": {"enum": ["policy", "always"]},
          "recovery": {"enum": ["retry-safe", "idempotent-key", "query-before-retry", "manual-reconcile"]},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "allOf": [
          {"if": {"properties": {"effect": {"const": "external-write"}}}, "then": {"properties": {"approval": {"const": "always"}, "recovery": {"enum": ["idempotent-key", "query-before-retry", "manual-reconcile"]}}}}
        ]
      }
    },
    "instructions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["storageVersion", "uninstall"],
      "properties": {
        "storageVersion": {"type": "integer", "minimum": 1},
        "uninstall": {"const": "retain"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["disable", "codeUpgrade"],
      "properties": {
        "disable": {"const": "drain-and-revoke"},
        "codeUpgrade": {"const": "restart-if-required"}
      }
    },
    "dependencies": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$", "maxLength": 96},
          "version": {"$ref": "#/$defs/version"}
        }
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$", "maxLength": 64},
    "relativePath": {"type": "string", "pattern": "^(?![./])(?!.*\\.\\.)(?!.*//)[A-Za-z0-9_/-]+\\.(mjs|json|md)$", "maxLength": 200}
  }
}
